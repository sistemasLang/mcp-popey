PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=your_database
PGUSER=mcp_popey_ro
PGPASSWORD=replace_me

# Bases adicionales: un usuario con `database: <k>` en users.yaml usa DB_<K>_DSN.
# La clave "default" usa las variables PG* de arriba.
# DB_LANG_DSN=postgresql://user:password@host:5432/prod
# DB_DEMO_DSN=postgresql://user:password@host:5432/demodb

DB_POOL_MIN=1
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_DEFAULT_ROW_LIMIT=1000

MCP_PORT=8000
# Agregar el dominio público cuando se configure el proxy HTTPS.
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
# URL pública del MCP (la del proxy HTTPS en producción).
MCP_PUBLIC_URL=http://localhost:8000
