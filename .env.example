# mcp-popey: copy to .env (next to package.json) and fill in.
# An empty value (VAR=) means "use the default". Relative paths are resolved
# from the project folder, not from the directory you launch the process in.
# Variables set by pm2 (ecosystem.config.cjs `env`) take precedence over this file.

# --- OAuth (Auth0) ---
# Tenant domain, without https:// (empresa.us.auth0.com)
AUTH0_DOMAIN=
# Public https URL of /mcp = identifier of the "MCP" API in Auth0 (the token audience)
MCP_RESOURCE_URL=
# Identifier of the "Admin" API in Auth0 (audience of the panel tokens). Must differ from MCP_RESOURCE_URL.
ADMIN_API_AUDIENCE=
# M2M app of this server for the Auth0 Management API (creates people and service accounts)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Optional, default Username-Password-Authentication
AUTH0_DB_CONNECTION=
# Optional: emails (already created in Auth0) linked as admins on the first start
BOOTSTRAP_ADMIN_EMAILS=
# Optional, default 86400 (300 to 604800): lifetime of the password links
PASSWORD_LINK_TTL_SECONDS=

# --- Server (only nginx must reach it: keep 127.0.0.1) ---
MCP_HOST=127.0.0.1
MCP_PORT=3030

# --- Files ---
CIRCUITS_FILE=config/circuits.yaml
CIRCUIT_ACCESS_FILE=config/circuit-access.yaml
# Who has access (role + tenant). Written by the admin panel; format in config/users.example.yaml.
USERS_FILE=data/users.yaml
# Audit as JSON Lines. Empty: it goes to stderr (pm2 error log).
AUDIT_LOG_FILE=

# --- Tenant databases: one block DB_<KEY>_* per key ---
DATABASE_KEYS=lang,powerbi

DB_LANG_HOST=
DB_LANG_PORT=5432
DB_LANG_NAME=
DB_LANG_USER=mcp_popey_ro
DB_LANG_PASSWORD=
DB_LANG_SSL=true

DB_POWERBI_HOST=
DB_POWERBI_PORT=5432
DB_POWERBI_NAME=
DB_POWERBI_USER=mcp_popey_ro
DB_POWERBI_PASSWORD=
DB_POWERBI_SSL=true

# Another tenant (also add it to DATABASE_KEYS=lang,powerbi,cliente_b):
# DB_CLIENTE_B_HOST=
# DB_CLIENTE_B_PORT=5432
# DB_CLIENTE_B_NAME=
# DB_CLIENTE_B_USER=mcp_popey_ro
# DB_CLIENTE_B_PASSWORD=
# DB_CLIENTE_B_SSL=true

# --- Pool ---
# DB_POOL_MAX=5

# --- query_sql limits ---
# QUERY_SQL_MAX_ROWS=1000
# QUERY_SQL_TIMEOUT_MS=30000

# --- Rate limit (per user, query_sql only) ---
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_MS=60000
